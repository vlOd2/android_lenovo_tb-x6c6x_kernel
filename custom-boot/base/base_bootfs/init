#!/bin/sh

mount -t devtmpfs devtmpfs /dev
exec 1>/dev/kmsg
exec 2>&1

clear > /dev/tty0
chvt 1

log() {
    local level="$1"
    shift
    
    case "$level" in
        error)
            printf "<0>[ERROR] %s\n" "$*"
            ;;

        warn)
            printf "<0>[WARN] %s\n" "$*"
            ;;

        debug)
            printf "<6>[INFO] %s\n" "$*"
            ;;

        *)
            printf "<0>[INFO] %s\n" "$*"
            ;;
    esac
}

map_block_partitions() {
    mkdir -p /dev/block/by-name

    for uevent in /sys/class/block/*/uevent; do
        (
            . "$uevent" 2>/dev/null
            if [ -n "$PARTNAME" ] && [ -n "$DEVNAME" ]; then
                ln -sf "/dev/$DEVNAME" "/dev/block/by-name/$PARTNAME"
                mkdir -p /dev/block/bootdevice/by-name
                ln -sf "/dev/$DEVNAME" "/dev/block/bootdevice/by-name/$PARTNAME"
            fi
        )
    done
}

setup_usb_serial() {
    mkdir -p /sys/kernel/config/usb_gadget/g1
    cd /sys/kernel/config/usb_gadget/g1

    echo "0x1d6b" > idVendor
    echo "0x0104" > idProduct

    mkdir -p strings/0x409
    echo "1234567890" > strings/0x409/serialnumber
    echo "Manufacturer" > strings/0x409/manufacturer
    echo "Product" > strings/0x409/product

    mkdir -p configs/c.1/strings/0x409
    echo "CDC Serial" > configs/c.1/strings/0x409/configuration

    mkdir -p functions/acm.usb0
    ln -s functions/acm.usb0 configs/c.1/

    echo "musb-hdrc" > UDC
    cd -
}

log info "============================"
log info "      INIT STARTING UP      "
log info "============================"
log info "Current time: $(date)"

log info "Mounting filesystems"
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t configfs none /sys/kernel/config
mount -t pstore pstore /sys/fs/pstore

if [ -d /sys/fs/pstore ] && [ "$(ls -A /sys/fs/pstore 2>/dev/null)" ]; then
    log info "Dumping last kernel panic from pstore"
    cat /sys/fs/pstore/console-ramoops-* > /root/pstore_panic_console.log 2>/dev/null
    cat /sys/fs/pstore/dmesg-ramoops-* > /root/pstore_panic_dmesg.log 2>/dev/null
fi
if [ -f /proc/pl_lk ]; then
    log info "Signaling log_store we have booted"
    echo 0 > /proc/pl_lk
fi

log info "Mapping block partitions"
map_block_partitions
ls /dev/block/by-name/ > /dev/tty1

log info "Mapping super dynamic partitions"
dmsetup create --concise "$(parse-android-dynparts /dev/block/by-name/super)" 
ls -1 /dev/mapper/dynpart-* > /dev/tty1

log info "Setting up USB serial"
setup_usb_serial

# log info "Press volume up key in 3 seconds to enter recovery"
ENTER_RECOVERY=1
# if timeout 3 head -c 1 /dev/input/event1 >/dev/null 2>&1; then
#     ENTER_RECOVERY=1
#     log info "Volume up pressed, will enter recovery mode"
# fi

# log info "Mounting rootfs"
# mkdir -p /mnt/rootfs
# mount -t ext4 /dev/block/by-name/userdata /mnt/rootfs
# MOUNT_RESULT=$?
# log info "Mount exited with $MOUNT_RESULT"
MOUNT_RESULT=0

if [ $MOUNT_RESULT -eq 0 ] && [ $ENTER_RECOVERY -eq 0 ] && [ -x /mnt/rootfs/sbin/init ]; then
    log info "=========================="
    log info "      LOADING ROOTFS      "
    log info "=========================="

    log info "Extracting modules"
    tar -xvzf "/modules.tar.gz" -C "/mnt/rootfs/"

    log info "Copying initfs files"
    mkdir -p "/mnt/rootfs/wifi_init"
    cp -f "/wifi_init/"* "/mnt/rootfs/wifi_init/"

    log info "Moving filesystems"
    mount --move /dev /mnt/rootfs/dev
    mount --move /proc /mnt/rootfs/proc
    mount --move /sys /mnt/rootfs/sys
    umount /sys/kernel/config
    umount /sys/fs/pstore

    log info "Switching root to rootfs"
    exec switch_root /mnt/rootfs /sbin/init
else
    if [ $ENTER_RECOVERY -eq 0 ]; then
        log error "Failed to mount rootfs"
    fi
    log info "========================="
    log info "      RECOVERY MODE      "
    log info "========================="

    log warn "Starting recovery tty allocator"
    /recovery/tty_allocator &

    while true; do
        log debug "System is alive: $(date +%s)"
        sleep 2
    done
fi